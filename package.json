{
  "name": "yggio-mcp",
  "version": "0.1.0",
  "description": "MCP server (SDK v2: protocol 2026-07-28, with 2025 fallback) for the Yggio IoT platform REST API",
  "private": true,
  "type": "module",
  "bin": {
    "yggio-mcp": "dist/yggio-mcp.mjs"
  },
  "scripts": {
    "spec": "node scripts/build-spec.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/bundle.mjs",
    "mcpb": "npm run build && node scripts/pack-mcpb.mjs",
    "test": "npm run build && node --test test/"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/node": "^26.6.10",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
